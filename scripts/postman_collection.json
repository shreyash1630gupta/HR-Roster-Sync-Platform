{
  "info": {
    "name": "MoveInSync HR Roster Sync Service API",
    "_postman_id": "moveinsync-roster-sync-v1",
    "description": "Production Postman Collection for MoveInSync SDE Intern Case Study 5 - Idempotent, Out-of-Order, Self-Healing HR Roster Sync Engine.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "tenantId", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
    { "key": "hrToken", "value": "", "type": "string" },
    { "key": "transportToken", "value": "", "type": "string" },
    { "key": "operatorToken", "value": "", "type": "string" },
    { "key": "employeeId", "value": "", "type": "string" },
    { "key": "reconciliationRunId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Obtain HR_SYSTEM Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('hrToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"role\": \"HR_SYSTEM\",\n  \"subject\": \"hr-client\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        },
        {
          "name": "Obtain TRANSPORT_ADMIN Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('transportToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"role\": \"TRANSPORT_ADMIN\",\n  \"subject\": \"trans-admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        },
        {
          "name": "Obtain OPERATOR Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('operatorToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"role\": \"OPERATOR\",\n  \"subject\": \"ops-user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Real-Time Sync Ingestion",
      "item": [
        {
          "name": "Ingest Batch Events (CREATE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hrToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"evt-001\",\n      \"event_type\": \"CREATE\",\n      \"tenant_id\": \"{{tenantId}}\",\n      \"external_employee_id\": \"EMP-1001\",\n      \"source_version\": 1,\n      \"data\": {\n        \"name\": \"Alice Kumar\",\n        \"email\": \"alice@example.com\",\n        \"office_code\": \"BLR-EC\"\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sync", "events"]
            }
          }
        },
        {
          "name": "Ingest Stale Event (Should return SKIPPED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hrToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"event_id\": \"evt-002-stale\",\n      \"event_type\": \"UPDATE\",\n      \"tenant_id\": \"{{tenantId}}\",\n      \"external_employee_id\": \"EMP-1001\",\n      \"source_version\": 0,\n      \"data\": {\n        \"name\": \"Alice Stale\",\n        \"email\": \"alice@example.com\",\n        \"office_code\": \"BLR-EC\"\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sync", "events"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Employee Profile & Field Ownership",
      "item": [
        {
          "name": "List Employees (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.content && jsonData.content.length > 0) {",
                  "  pm.collectionVariables.set('employeeId', jsonData.content[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{transportToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employees"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Update Transport-Owned Fields",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{transportToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup_point\": \"Forum Mall Koramangala\",\n  \"special_assistance_needs\": \"Wheelchair\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}/transport-fields",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employees", "{{employeeId}}", "transport-fields"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Nightly Reconciliation & Safety Brake",
      "item": [
        {
          "name": "Review Reconciliation Run Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{operatorToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reconciliation/{{reconciliationRunId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reconciliation", "{{reconciliationRunId}}"]
            }
          }
        },
        {
          "name": "Operator Approve Reconciliation Run",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{operatorToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Approved quarterly attrition roster\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reconciliation/{{reconciliationRunId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reconciliation", "{{reconciliationRunId}}", "approve"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Outbox DLQ & Observability",
      "item": [
        {
          "name": "Get Outbox Dead-Letter Events",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{operatorToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/outbox/dead-letter",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "outbox", "dead-letter"]
            }
          }
        },
        {
          "name": "Scrape Prometheus Observability Metrics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{operatorToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/prometheus",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "prometheus"]
            }
          }
        }
      ]
    }
  ]
}

